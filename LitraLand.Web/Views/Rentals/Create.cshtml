@model RentalFormViewModel

@{
    ViewData["Title"] = "Add Rental";
}

<!--begin::outer Card-->
<div class="card mb-7">
    <!--begin::outer Card header-->
	<div class="card-header border-0 pt-6 d-flex justify-content-between align-items-center">
		<!--begin::title-->
		<div class="card-title">
			<h3 class="fw-bolder">Add Rental</h3>
		</div>
		<!--end::title-->
	</div>
    <!--end::outer Card header-->
    <!--begin::outer Card body-->
	<div class="card-body">
		<partial name="_SearchForm" model="new SearchFormViewModel()" />
	</div>
    <!--end::outer Card body-->
    <!--begin::inner card-->
    <div class="card mb-5 mb-xl-8">
        <!--begin::inner card Header-->
        <div class="card-header border-0 pt-5">
            <h3 class="card-title align-items-start flex-column">
                <span class="card-label fw-bold text-dark">Books</span>
                <span class="text-muted mt-1 fw-semibold fs-7">You can add up to @Model.MaxAllowedCopies book(s)</span>
            </h3>
        </div>
        <!--end::inner card Header-->
        <!--begin::inner card Body-->
        <div class="card-body pt-5">
            <form asp-action="Create" id="CopiesForm">
                <input type="hidden" asp-for="SubscriberKey" />
                @* Copies will be added here *@
                <button id="btnSubmit" type="submit" class="btn btn-primary">
                    <span class="indicator-label">
                        Save
                    </span>
                    <span class="indicator-progress">
                        Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </form>
        </div>
        <!--end::inner card Body-->
    </div>
    <!--end::inner card-->
</div>
<!--end::outer Card-->
@section Scripts
{
	<partial name="_ValidationScriptsPartial" />
    <script>
        let maxAllowedCopies = @Model.MaxAllowedCopies
    </script>
    <script src="~/js/rental-form.js" asp-append-version="true"></script>
}