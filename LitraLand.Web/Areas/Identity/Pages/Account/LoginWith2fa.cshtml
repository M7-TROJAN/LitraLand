@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<div class="d-flex flex-column flex-root">
    <!--begin::Page bg image-->
    <style>
        body {
            background-image: url('/assets/images/bg10.jpeg');
        }

        [data-theme="dark"] body {
            background-image: url('/assets/images/bg10-dark.jpeg');
        }
    </style>
    <!--end::Page bg image-->
    <!--begin::Authentication - Sign-in -->
    <div class="d-flex flex-column flex-lg-row flex-column-fluid">
        <!--begin::Aside-->
        <div class="d-flex flex-lg-row-fluid hidden-on-mobile">
            <!--begin::Content-->
            <div class="d-flex flex-column flex-center pb-0 pb-lg-10 p-10 w-100">
                <!--begin::Image-->
                <img class="mx-auto mw-100 w-150px w-lg-500px mb-10" src="~/assets/images/Authentication-amico.svg" alt="2FA Authentication" />
                <!--end::Image-->
                <!--begin::Title-->
                <h1 class="text-gray-800 fs-2qx fw-bold text-center mb-7">LitraLand, by FGSSR</h1>
                <!--end::Title-->
                <!--begin::Text-->
                <div class="text-gray-600 fs-base text-center fw-semibold">
                    Welcome to <span class="fw-bold text-primary">LitraLand</span>, your gateway to a world of books!
                    Whether you're looking to buy, sell, or exchange books, our platform connects readers and book lovers in one place.
                    <br />Explore a vast collection of titles, discover hidden gems, and share your literary passion with a vibrant community.
                </div>
                <!--end::Text-->
            </div>
            <!--end::Content-->
        </div>
        <!--begin::Aside-->
        <!--begin::Body-->
        <div class="d-flex flex-column-fluid flex-lg-row-auto justify-content-center justify-content-lg-end p-12">
            <!--begin::Wrapper-->
            <div class="bg-body d-flex flex-center rounded-4 w-md-600px p-10">
                <!--begin::Content-->
                <div class="w-md-400px">
                    <!--begin::Form-->
                    <form class="form w-100 mb-13" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <input asp-for="RememberMe" type="hidden" />
                        <!--begin::Icon-->
                        <div class="text-center mb-10">
                            <img alt="Logo" class="mh-125px" src="~/assets/images/smartphone-2.svg">
                        </div>
                        <!--end::Icon-->
                        <!--begin::Heading-->
                        <div class="text-center mb-10">
                            <!--begin::Title-->
                            <h1 class="text-gray-900 mb-3">
                                Two-Factor Verification
                            </h1>
                            <!--end::Title-->
                            <!--begin::Sub-title-->
                            <div class="text-muted fw-semibold fs-5 mb-5">Enter the verification code we sent to</div>
                            <!--end::Sub-title-->
                            <!--begin::Mobile no-->
                            <div class="fw-bold text-gray-900 fs-3">@Model.MaskedEmail</div>
                            <!--end::Mobile no-->
                        </div>
                        <!--end::Heading-->
                        <!--begin::Section-->
                        <div class="mb-10">
                            <!--begin::Label-->
                            <div class="text-center mb-4">
                                <div class="fw-bold text-gray-900 fs-4">Type your 6-digit security code</div>
                            </div>
                            <!--end::Label-->
                            <!--begin::Input group-->
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <input type="text" asp-for="Input.Code1" maxlength="1" required class="form-control form-control-solid h-60px w-60px fs-2qx text-center mx-1 my-2" inputmode="text" id="firstInput">
                                <input type="text" asp-for="Input.Code2" maxlength="1" required class="form-control form-control-solid h-60px w-60px fs-2qx text-center mx-1 my-2" inputmode="text">
                                <input type="text" asp-for="Input.Code3" maxlength="1" required class="form-control form-control-solid h-60px w-60px fs-2qx text-center mx-1 my-2" inputmode="text">
                                <input type="text" asp-for="Input.Code4" maxlength="1" required class="form-control form-control-solid h-60px w-60px fs-2qx text-center mx-1 my-2" inputmode="text">
                                <input type="text" asp-for="Input.Code5" maxlength="1" required class="form-control form-control-solid h-60px w-60px fs-2qx text-center mx-1 my-2" inputmode="text">
                                <input type="text" asp-for="Input.Code6" maxlength="1" required class="form-control form-control-solid h-60px w-60px fs-2qx text-center mx-1 my-2" inputmode="text">
                            </div>
                            <!--end:Input group-->
                            <!--begin:Input group RememberMachine-->
                            <div class="row mb-2 mt-3">
                                <div class="col">
                                    <div class="form-check form-switch form-check-solid form-check-custom mb-2">
                                        <input class="form-check-input" type="checkbox" asp-for="Input.RememberMachine">
                                        <label class="form-check-label" asp-for="Input.RememberMachine"></label>
                                    </div>
                                </div>
                            </div>
                            <!--end:Input group RememberMachine-->
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        </div>
                        <!--end::Section-->
                        <!--begin::Submit-->
                        <div class="d-flex flex-center">
                            <button type="submit" id="kt_sing_in_two_factor_submit" class="btn btn-lg btn-primary fw-bold">
                                <span class="indicator-label">
                                    Submit
                                </span>
                                <span class="indicator-progress">
                                    Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                </span>
                            </button>
                        </div>
                        <!--end::Submit-->
                    </form>
                    <!--end::Form-->
                    <!--begin::Notice-->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-2">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    <div class="text-center fw-semibold fs-5">
                        <span class="text-muted me-1">Didn’t get the code ?</span>

                        <a asp-page-handler="Resend" class="link-primary fs-5 me-1">Resend</a>

                        <span class="text-muted me-1">or</span>

                        <a href="#" class="link-primary fs-5">Call Us</a>
                    </div>
                    <!--end::Notice-->
                </div>
                <!--end::Content-->
            </div>
            <!--end::Wrapper-->
        </div>
        <!--end::Body-->
    </div>
    <!--end::Authentication - Sign-in-->
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/user/verify2fa.js" asp-append-version="true"></script>
}

