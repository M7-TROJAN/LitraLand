@page
@model SetPasswordModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}


<div class="card shadow-lg border-0 rounded-3">
    <div class="card-header bg-primary text-white py-4 rounded-top">
        <h3 class="mb-0 text-center">@ViewData["Title"]</h3>
    </div>

    <div class="card-body p-4 p-md-5">
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="row align-items-center">
            <!-- Form Column -->
            <div class="col-md-6">
                <form id="set-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="flex-shrink-0 text-primary">
                                <i class="fas fa-lock fa-2x text-primary"></i>
                            </div>
                            <div class="ms-3">
                                <h4 class="mb-1" style="font-size: 1.4rem;">Password Security</h4>
                                <p class="text-muted mb-0" style="font-size: 1rem;">Protect your account with a strong password</p>
                                <!--begin::Separator-->
                                <div class="separator separator-content my-1"></div>
                                <!--end::Separator-->
                                <p class="text-muted mb-0" style="font-size: 0.9rem;">
                                    You do not have a local password for our site. <br /> 
                                    Add a password so you can log in without an external login.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!--begin::NewPassword-->
                    <div class="fv-row mb-5">
                        <div class="mb-1">
                            <!--begin::Label-->
                            <label class="form-label fw-semibold fs-6 mb-2" asp-for="Input.Password"></label>
                            <!--end::Label-->
                            <!--begin::Input-->
                            <div class="position-relative mb-3">
                                <input asp-for="Input.Password" type="password" class="form-control form-control-lg form-control-solid new-password-input" placeholder="Use 8 or more characters with a mix of letters, numbers & symbols." autocomplete="off" />
                                <!--begin::Visibility toggle (العين الي بتظهر الباسورد)-->
                                <button type="button" id="togglePassword" class="btn btn-sm btn-icon position-absolute translate-middle top-50 end-0 me-n2">
                                    <i class="bi bi-eye-slash fs-2"></i>
                                </button>
                                <!--end::Visibility toggle-->
                            </div>
                            <!--end::Input-->
                            <!--begin::Highlight meter-->
                            <div class="password-strength mt-2">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                                <small class="text-muted">Password strength: <span id="strengthText">Weak</span></small>
                            </div>
                            <!--end::Highlight meter-->
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <!--end::NewPassword-->
                    <!--begin::ConfirmPassword-->
                    <div class="fv-row mb-5">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-solid" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <!--end::ConfirmPassword-->
                    <!--begin::submit Button-->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg py-3">
                            <i class="fas fa-sync-alt me-2"></i>Set Password
                        </button>
                    </div>
                    <!--end::submit Button-->
                </form>
            </div>
            <!-- Illustration Column -->
            <div class="col-md-6 mb-4 mb-md-0 text-center hide-in-small-screens">
                <img src="~/assets/images/reset-password.svg" alt="Set Password" class="img-fluid animated-img" style="max-height: 450px;">
            </div>
        </div>
    </div>

    <div class="card-footer bg-light py-3 text-center small text-muted">
        <i class="fas fa-info-circle me-1"></i>
        Use a minimum of 8 characters including numbers, symbols, and uppercase letters.
    </div>
</div>


<style>
    .animated-img {
        transition: transform 0.3s ease;
    }

    .animated-img:hover {
        transform: scale(1.05);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const passwordInput = document.querySelector('.new-password-input');

        // Password strength indicator
        passwordInput.addEventListener('input', function() {
            const strength = calculatePasswordStrength(this.value);
            const progressBar = document.querySelector('.progress-bar');
            const strengthText = document.getElementById('strengthText');

            progressBar.style.width = strength.percentage + '%';
            progressBar.className = 'progress-bar bg-' + strength.color;
            strengthText.textContent = strength.text;
        });

        document.getElementById("togglePassword").addEventListener("click", function () {
            var eyeIcon = this.querySelector("i");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeIcon.classList.remove("bi-eye-slash");
                eyeIcon.classList.add("bi-eye");

            } else {
                passwordInput.type = "password";
                eyeIcon.classList.remove("bi-eye");
                eyeIcon.classList.add("bi-eye-slash");
            }
        });

        function calculatePasswordStrength(password) {
            let strength = 0;
            // if (password.match(/[a-z]/)) strength++;
            // if (password.match(/[0-9]/)) strength++;
            if (password.match(/(?=.*[a-z])(?=.*[0-9])/)) strength++;
            if (password.match(/[A-Z]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;
            if (password.length >= 8) strength++;

            switch(strength) {
                case 0: return { percentage: 0, color: 'danger', text: 'Very Weak' };
                case 1: return { percentage: 25, color: 'danger', text: 'Weak' };
                case 2: return { percentage: 50, color: 'warning', text: 'Moderate' };
                case 3: return { percentage: 75, color: 'info', text: 'Strong' };
                default: return { percentage: 100, color: 'success', text: 'Very Strong' };
            }
        }
    </script>
}

