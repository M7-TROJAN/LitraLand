@{
    ViewData["Title"] = "About Litraland";
}

<div class="container mt-5">
    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">Welcome to <span class="text-primary">Litraland</span></h1>
        <p class="lead text-muted">A platform for managing libraries and facilitating book sales and exchanges.</p>
        <img src="https://via.placeholder.com/800x300" alt="Bookshelf" class="img-fluid rounded shadow">
    </div>

    <!-- About Section -->
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h2 class="fw-bold">What is Litraland?</h2>
            <p class="text-muted">
                Litraland is an integrated library management system that allows users to manage their libraries, buy, and exchange books easily.
                It provides a user-friendly environment for both readers and library owners.
            </p>
        </div>
        <div class="col-md-6 text-center">
            <img src="https://via.placeholder.com/400" alt="Library Concept" class="img-fluid rounded shadow">
        </div>
    </div>

    <!-- Features Section -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">Why Choose <span class="text-primary">Litraland</span>?</h2>
    </div>
    <div class="row text-center">
        <div class="col-md-4">
            <div class="p-4 border rounded shadow-sm">
                <i class="bi bi-book fs-1 text-primary"></i>
                <h5 class="mt-3">Library Management</h5>
                <p class="text-muted">Easily add and manage books with multiple categories.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border rounded shadow-sm">
                <i class="bi bi-people fs-1 text-success"></i>
                <h5 class="mt-3">User Interaction</h5>
                <p class="text-muted">Create profiles and connect with other readers.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border rounded shadow-sm">
                <i class="bi bi-cart-check fs-1 text-warning"></i>
                <h5 class="mt-3">Buy & Exchange Books</h5>
                <p class="text-muted">List books for sale or exchange in a simple way.</p>
            </div>
        </div>
    </div>

    <!-- Statistics Section -->
    <div class="text-center mt-5 mb-5">
        <h2 class="fw-bold">Quick Statistics</h2>
    </div>
    <div class="row text-center">
        <div class="col-md-3">
            <h3 class="text-primary fw-bold">500+</h3>
            <p class="text-muted">Registered Libraries</p>
        </div>
        <div class="col-md-3">
            <h3 class="text-success fw-bold">10K+</h3>
            <p class="text-muted">Available Books</p>
        </div>
        <div class="col-md-3">
            <h3 class="text-warning fw-bold">20K+</h3>
            <p class="text-muted">Active Users</p>
        </div>
        <div class="col-md-3">
            <h3 class="text-danger fw-bold">99%</h3>
            <p class="text-muted">Customer Satisfaction</p>
        </div>
    </div>

    <!-- Contact Section -->
    <div class="text-center mt-5">
        <h2 class="fw-bold">Contact Us</h2>
        <p class="text-muted">Have any questions? Feel free to reach out!</p>
        <a href="mailto:contact@litraland.com" class="btn btn-primary btn-lg">Get in Touch</a>
    </div>
</div>
