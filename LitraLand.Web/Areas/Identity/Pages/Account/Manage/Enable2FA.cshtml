@page
@model Enable2FAModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Enable Two-Factor Authentication";
}

<div class="card">
    <div class="card-header bg-primary text-white py-3 rounded-top">
        <h3 class="mb-0 text-center">@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <div class="row d-flex justify-content-center align-items-center flex-column-reverse flex-md-row">
            <!-- Form Column -->
            <div class="col-md-6 mt-4">
                <form id="enable-2fa-form" method="post">
                    <div class="mb-5">
                        <!-- Security Header -->
                        <div class="d-flex align-items-center mb-4">
                            <div class="flex-shrink-0 text-primary">
                                <i class="fas fa-shield-alt fa-3x text-primary"></i>
                            </div>
                            <div class="ms-4">
                                <h4 class="mb-2" style="font-size: 1.5rem;">Enhance Your Account Security</h4>
                                <p class="text-muted mb-0" style="font-size: 1.1rem;">An extra layer of protection for your information</p>
                            </div>
                        </div>

                        <!-- Email Alert -->
                        <div class="alert alert-info border-start border-4 border-info text-start p-4 mb-4">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-envelope fa-lg me-3 text-hover-primary"></i>
                                <div>
                                    <p class="mb-1" style="font-size: 1.1rem; font-weight: 500;">
                                        A verification code will be sent to your email
                                    </p>
                                    <p class="mb-0" style="font-size: 1rem;">
                                        Please check your inbox or spam folder
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Features List -->
                        <ul class="list-unstyled mb-5" style="font-size: 1.1rem;">
                            <li class="mb-3 d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-3 fa-lg"></i>
                                <span>6-digit verification code</span>
                            </li>
                            <li class="mb-3 d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-3 fa-lg"></i>
                                <span>Valid for 15 minutes</span>
                            </li>
                            <li class="d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-3 fa-lg"></i>
                                <span>One-time requirement</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-primary py-3" style="font-size: 1.25rem;">
                            <span class="indicator-label">
                                <i class="fas fa-lock-open me-2"></i>Enable Two-Factor Authentication
                            </span>
                            <span class="indicator-progress">
                                Processing...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>

                        <a href="#" class="btn btn-outline-secondary py-2" data-bs-toggle="tooltip"
                           title="The verification code will be sent to your registered email"
                           style="font-size: 1rem;">
                            <i class="fas fa-question-circle me-2"></i>How does this work?
                        </a>
                    </div>
                </form>
            </div>
            <!-- Image Column - Removed max-height constraint -->
            <div class="col-md-5 offset-md-1 mt-4 mt-md-0 text-center hide-in-small-screens">
                <img src="~/assets/images/Two-factor-authentication.svg" alt="Enable Two-Factor Authentication" class="img-fluid animated-img" style="max-height: 450px;"/>
                <div class="mt-3">
                    <span class="badge bg-info text-dark">Extra Security</span>
                    <span class="badge bg-warning text-dark mx-2">Better Protection</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card-footer bg-light py-3 text-center small text-muted">
        <i class="fas fa-info-circle me-1"></i> You won't be able to login without verification code after enabling
    </div>
</div>

<style>
    .animated-img {
        transition: transform 0.3s ease;
    }
    .animated-img:hover {
        transform: scale(1.05);
    }
</style>