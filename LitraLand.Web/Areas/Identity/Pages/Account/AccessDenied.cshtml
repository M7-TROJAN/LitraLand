@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}


<div class="text-center">
    <img src="~/assets/images/401.svg" alt="Unauthorize" class="h-400px mt-5"/>
    <header>
        <h1 class="text-danger fw-bold mb-3">@ViewData["Title"]</h1>
        <p class="text-muted fs-5">Oops! You don't have permission to access this page.</p>

        <!-- Back to Home Button -->
        <a href="~/" class="btn btn-primary mt-4">
            <i class="fas fa-home me-5"></i> Back to Home
        </a>
    </header>
</div>
