@model CommunityBookViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery

@{
    ViewData["Title"] = Model.Title;
    var ownerHasPhoneNumber = !string.IsNullOrEmpty(Model.OwnerPhoneNumber);
    var ownerPhoneNumber = ownerHasPhoneNumber ? $"2{Model.OwnerPhoneNumber}" : string.Empty;
}

<div class="content flex-column-fluid" id="kt_content">
    <div class="card mb-9">
        <div class="card-body pt-9 pb-0">
            <!--begin::Details-->
            <div class="d-flex flex-wrap flex-sm-nowrap mb-6">
                <!--begin::Image-->
                <div class="d-flex flex-center flex-shrink-0 bg-light rounded w-100px h-100px w-lg-150px h-lg-150px me-7 mb-4">
                    <a data-fslightbox href="@(string.IsNullOrEmpty(Model.ImageUrl)? "/images/books/no-book.jpg" : Model.ImageUrl)">
                        <img class="mw-50px mw-lg-75px" src="@(string.IsNullOrEmpty(Model.ImageThumbnailUrl)? "/images/books/no-book.jpg" : Model.ImageThumbnailUrl)" alt="@Model.Title" />
                    </a>
                </div>
                <!--end::Image-->
                <!--begin::Wrapper-->
                <div class="flex-grow-1">
                    <!--begin::Head-->
                    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                        <!--begin::Details-->
                        <div class="d-flex flex-column">
                            <!--begin::Status-->
                            <div class="d-flex align-items-center mb-1">
                                <a href="#" class="text-gray-800 text-hover-primary fs-2 fw-bold me-3">@Model.Title</a>
                            </div>
                            <!--end::Status-->
                            <!--begin::Author-->
                            <div class="d-flex flex-wrap mb-2 fs-7 text-gray-400">
                                Author: <span class="ms-2 text-primary">@Model.Author</span>
                            </div>
                            <!--end::Author-->
                            <!--begin::badges-->
                            <div class="text-gray-600 small mb-1 d-flex flex-wrap gap-2 align-items-center">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-@(Model.IsForExchange ? "arrow-left-right text-success" : "x-circle text-muted") me-1"></i>
                                    <span class="badge badge-light-@(Model.IsForExchange ? "success" : "warning") me-auto"
                                          title="@(Model.IsForExchange ? "This book is available for exchange" : "This book is not for exchange")">
                                        @(Model.IsForExchange ? "Available for Exchange" : "Not available for Exchange")
                                    </span>
                                </div>
                            </div>
                            <!--end::badges-->
                        </div>
                        <!--end::Details-->
                        <!--begin::Actions-->
                        @if (User.GetUserId() == Model.OwnerId)
                        {
                            <div class="d-flex mb-4">
                                <a asp-action="Edit" asp-route-key="@Model.Key" class="btn btn-sm btn-primary me-3">Edit</a>
                                <a href="javascript:;"
                                   data-name="Book"
                                   data-url="/Community/CommunityBooks/Delete?key=@Model.Key"
                                   data-redirect-url="/Community/CommunityHome"
                                   class="btn btn-sm btn-danger fw-semibold text-nowrap js-delete-community-book">
                                    Delete
                                </a>

                            </div>
                        }
                        else if(User.IsAdmin())
                        {
                            <a href="javascript:;"
                               data-name="Book"
                               data-url="/Community/CommunityBooks/Delete?key=@Model.Key"
                               data-redirect-url="/Community/CommunityHome"
                               class="btn btn-sm btn-danger fw-semibold text-nowrap js-delete-community-book">
                                Delete
                            </a>
                        }
                        <!--end::Actions-->
                    </div>
                    <!--end::Head-->
                    <!--begin::Info-->
                    <div class="d-flex flex-wrap justify-content-start">
                        <!--begin::Stats-->
                        <div class="d-flex flex-wrap">
                            <!--begin::Price-->
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <!--begin::Number-->
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-dollar-sign text-primary me-2"></i>
                                    <div class="fs-7 fw-bold">@Model.Price EGP</div>
                                </div>
                                <!--end::Number-->
                                <!--begin::Label-->
                                <div class="fw-semibold fs-6 text-gray-400">Price</div>
                                <!--end::Label-->
                            </div>
                            <!--end::price-->
                            <!--begin::Added Date-->
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <!--begin::Number-->
                                <div class="d-flex align-items-center">
                                    <span class="svg-icon svg-icon-3 svg-icon-primary me-2">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path opacity="0.3" d="M21 22H3C2.4 22 2 21.6 2 21V5C2 4.4 2.4 4 3 4H21C21.6 4 22 4.4 22 5V21C22 21.6 21.6 22 21 22Z" fill="currentColor" />
                                            <path d="M6 6C5.4 6 5 5.6 5 5V3C5 2.4 5.4 2 6 2C6.6 2 7 2.4 7 3V5C7 5.6 6.6 6 6 6ZM11 5V3C11 2.4 10.6 2 10 2C9.4 2 9 2.4 9 3V5C9 5.6 9.4 6 10 6C10.6 6 11 5.6 11 5ZM15 5V3C15 2.4 14.6 2 14 2C13.4 2 13 2.4 13 3V5C13 5.6 13.4 6 14 6C14.6 6 15 5.6 15 5ZM19 5V3C19 2.4 18.6 2 18 2C17.4 2 17 2.4 17 3V5C17 5.6 17.4 6 18 6C18.6 6 19 5.6 19 5Z" fill="currentColor" />
                                            <path d="M8.8 13.1C9.2 13.1 9.5 13 9.7 12.8C9.9 12.6 10.1 12.3 10.1 11.9C10.1 11.6 10 11.3 9.8 11.1C9.6 10.9 9.3 10.8 9 10.8C8.8 10.8 8.59999 10.8 8.39999 10.9C8.19999 11 8.1 11.1 8 11.2C7.9 11.3 7.8 11.4 7.7 11.6C7.6 11.8 7.5 11.9 7.5 12.1C7.5 12.2 7.4 12.2 7.3 12.3C7.2 12.4 7.09999 12.4 6.89999 12.4C6.69999 12.4 6.6 12.3 6.5 12.2C6.4 12.1 6.3 11.9 6.3 11.7C6.3 11.5 6.4 11.3 6.5 11.1C6.6 10.9 6.8 10.7 7 10.5C7.2 10.3 7.49999 10.1 7.89999 10C8.29999 9.90003 8.60001 9.80003 9.10001 9.80003C9.50001 9.80003 9.80001 9.90003 10.1 10C10.4 10.1 10.7 10.3 10.9 10.4C11.1 10.5 11.3 10.8 11.4 11.1C11.5 11.4 11.6 11.6 11.6 11.9C11.6 12.3 11.5 12.6 11.3 12.9C11.1 13.2 10.9 13.5 10.6 13.7C10.9 13.9 11.2 14.1 11.4 14.3C11.6 14.5 11.8 14.7 11.9 15C12 15.3 12.1 15.5 12.1 15.8C12.1 16.2 12 16.5 11.9 16.8C11.8 17.1 11.5 17.4 11.3 17.7C11.1 18 10.7 18.2 10.3 18.3C9.9 18.4 9.5 18.5 9 18.5C8.5 18.5 8.1 18.4 7.7 18.2C7.3 18 7 17.8 6.8 17.6C6.6 17.4 6.4 17.1 6.3 16.8C6.2 16.5 6.10001 16.3 6.10001 16.1C6.10001 15.9 6.2 15.7 6.3 15.6C6.4 15.5 6.6 15.4 6.8 15.4C6.9 15.4 7.00001 15.4 7.10001 15.5C7.20001 15.6 7.3 15.6 7.3 15.7C7.5 16.2 7.7 16.6 8 16.9C8.3 17.2 8.6 17.3 9 17.3C9.2 17.3 9.5 17.2 9.7 17.1C9.9 17 10.1 16.8 10.3 16.6C10.5 16.4 10.5 16.1 10.5 15.8C10.5 15.3 10.4 15 10.1 14.7C9.80001 14.4 9.50001 14.3 9.10001 14.3C9.00001 14.3 8.9 14.3 8.7 14.3C8.5 14.3 8.39999 14.3 8.39999 14.3C8.19999 14.3 7.99999 14.2 7.89999 14.1C7.79999 14 7.7 13.8 7.7 13.7C7.7 13.5 7.79999 13.4 7.89999 13.2C7.99999 13 8.2 13 8.5 13H8.8V13.1ZM15.3 17.5V12.2C14.3 13 13.6 13.3 13.3 13.3C13.1 13.3 13 13.2 12.9 13.1C12.8 13 12.7 12.8 12.7 12.6C12.7 12.4 12.8 12.3 12.9 12.2C13 12.1 13.2 12 13.6 11.8C14.1 11.6 14.5 11.3 14.7 11.1C14.9 10.9 15.2 10.6 15.5 10.3C15.8 10 15.9 9.80003 15.9 9.70003C15.9 9.60003 16.1 9.60004 16.3 9.60004C16.5 9.60004 16.7 9.70003 16.8 9.80003C16.9 9.90003 17 10.2 17 10.5V17.2C17 18 16.7 18.4 16.2 18.4C16 18.4 15.8 18.3 15.6 18.2C15.4 18.1 15.3 17.8 15.3 17.5Z" fill="currentColor" />
                                        </svg>
                                    </span>
                                    <div class="fs-7 fw-bold">@Model.CreatedOn.ToString("dd MMM, yyyy")</div>
                                </div>
                                <!--end::Number-->
                                <!--begin::Label-->
                                <div class="fw-semibold fs-6 text-gray-400">Added Date</div>
                                <!--end::Label-->
                            </div>
                            <!--end::Added Date-->
                            <!--begin::Contact via WhatsApp-->
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <!--begin::Number-->
                                <div class="d-flex align-items-center">
                                    <span class="svg-icon svg-icon-3 svg-icon-primary me-2">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M20.1 3.9C17.8 1.7 14.5 0.5 11 0.5C5.2 0.5 0.5 5.2 0.5 11C0.5 13.2 1.1 15.3 2.2 17.1L0.5 23L6.6 21.4C8.3 22.3 10.1 22.8 12 22.8C17.8 22.8 22.5 18.1 22.5 12.3C22.5 8.8 21.3 5.5 20.1 3.9ZM11 20.5C9.4 20.5 7.8 20 6.5 19.1L6.2 18.9L3.1 19.8L4 16.8L3.8 16.5C2.8 15.2 2.3 13.6 2.3 12C2.3 6.2 6.2 2.3 11 2.3C13.3 2.3 15.5 3.2 17.2 4.9C18.9 6.6 19.8 8.8 19.8 11C19.8 15.8 15.9 20.5 11 20.5ZM16.2 14.8C15.9 14.6 14.5 13.9 14.2 13.8C13.9 13.7 13.7 13.6 13.5 13.9C13.3 14.2 12.8 14.8 12.6 15C12.4 15.2 12.2 15.2 11.9 15.1C11.6 15 10.7 14.7 9.6 13.8C8.7 12.9 8 11.9 7.8 11.6C7.6 11.3 7.8 11.1 7.9 11C8 10.9 8.1 10.7 8.3 10.5C8.5 10.3 8.6 10.2 8.7 10C8.8 9.8 8.7 9.6 8.6 9.5C8.5 9.4 8 8.9 7.8 8.7C7.6 8.5 7.4 8.6 7.2 8.6C7 8.6 6.8 8.6 6.6 8.6C6.4 8.6 6.1 8.7 5.9 9C5.7 9.3 5.7 9.8 5.7 10.3C5.7 10.8 5.9 11.3 6.2 11.7C6.5 12.1 7.2 13.2 8.3 14.1C9 14.7 9.8 15.2 10.7 15.5C11.6 15.8 12.4 15.7 13 15.6C13.6 15.5 14.2 15.1 14.5 14.7C14.8 14.3 14.8 14 14.7 13.9C14.6 13.8 14.4 13.8 14.2 13.8Z" fill="currentColor" />
                                        </svg>
                                    </span>
                                    @if (ownerHasPhoneNumber)
                                    {
                                        <div class="fs-7 fw-bold">
                                            <a href="https://wa.me/@ownerPhoneNumber" target="_blank" class="fs-7 fw-bold owner-contact-link">@Model.OwnerPhoneNumber</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fs-7 fw-bold text-danger">Phone number not available</div>
                                    }
                                </div>
                                <!--end::Number-->
                                <!--begin::Label-->
                                <div class="fw-semibold fs-6 text-gray-400">Contact via WhatsApp</div>
                                <!--end::Label-->
                            </div>
                            <!--end::Contact via WhatsApp-->
                            <!--begin::Contact via Email-->
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <span class="svg-icon svg-icon-3 svg-icon-primary me-2">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 18H4V8L12 13L20 8V18ZM12 11L4 6H20L12 11Z" fill="currentColor" />
                                        </svg>
                                    </span>
                                    <div class="fs-7 fw-bold">
                                        <a href="mailto:@Model.OwnerEmail" class="fs-7 fw-bold owner-contact-link">@Model.OwnerEmail</a>
                                    </div>
                                </div>
                                <!--begin::Label-->
                                <div class="fw-semibold fs-6 text-gray-400">Contact via Email</div>
                                <!--end::Label-->
                            </div>
                            <!--end::Contact via Email-->
                            <!--begin::Owner-->
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-badge fs-2 text-primary"></i>
                                    <div class="fs-7 fw-bold">
                                        <a asp-controller="Members" asp-action="Profile" asp-route-id="@Model.OwnerId" class="ms-2 owner-contact-link">@Model.OwnerUserName</a>
                                    </div>
                                </div>
                                <!--begin::Label-->
                                <div class="fw-semibold fs-6 text-gray-400">Book Owner Profile</div>
                                <!--end::Label-->
                            </div>
                            <!--end::Owner-->
                        </div>
                        <!--end::Stats-->
                    </div>
                    <!--end::Info-->
                </div>
                <!--end::Wrapper-->
            </div>
            <!--end::Details-->
            <div class="separator"></div>

            <!--begin::Nav-->
            <ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
                <li class="nav-item">
                    <a class="nav-link text-active-primary py-5 me-6 active" data-bs-toggle="tab" href="#Description">Description</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-active-primary py-5 me-6" data-bs-toggle="tab" href="#Reviews">Reviews</a>
                </li>
            </ul>
            <!--end::Nav-->
        </div>
    </div>

    <!-- begin::Tab Content -->
    <div class="tab-content">
        <!--begin::Description Card-->
        <div id="Description" class="card tab-pane fade show active">
            <!--begin::Card header-->
            <div class="card-header">
                <!--begin::Card title-->
                <div class="card-title fs-3 fw-bold">Description</div>
                <!--end::Card title-->
            </div>
            <!--end::Card header-->
            <div class="card-body">
                @Html.Raw(Model.Description)
            </div>
        </div>
        <!--end::Description Card-->
        <!--begin::Comments Card-->
        <div id="Reviews" class="card tab-pane fade">
            <!--begin::Card header-->
            <div class="card-header">
                <!--begin::Card title-->
                <div class="card-title fs-3 fw-bold">Reviews</div>
                <!--end::Card title-->
                <!--begin:: Add Button-->
                <div class="card-toolbar">
                    <a href="javascript:;" class="btn btn-sm btn-primary js-add-review"
                       data-title="Add Review" data-url="todo">
                        <i class="bi bi-plus-square-dotted"></i>
                        Write a review
                    </a>
                </div>
                <!--end:: Add Button-->
            </div>
            <!--end::Card header-->
            <div class="card-body">
                @*if there are no copies for this book, show an alert message*@
                @* <div class="@(Model.Comments.Any() ? "d-none" : string.Empty) alert alert-dismissible bg-light-warning border border-warning border-3 border-dashed d-flex flex-column flex-sm-row w-100 p-5 mb-10 js-alert">
                    <!--begin::Icon-->
                    <!--begin::Svg Icon | path: icons/duotune/general/gen007.svg-->
                    <span class="svg-icon svg-icon-2hx svg-icon-warning me-4 mb-5 mb-sm-0">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor" />
                            <rect x="11" y="14" width="7" height="2" rx="1" transform="rotate(-90 11 14)" fill="currentColor" />
                            <rect x="11" y="17" width="2" height="2" rx="1" transform="rotate(-90 11 17)" fill="currentColor" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                    <!--end::Icon-->
                    <!--begin::Content-->
                    <div class="d-flex flex-column pe-0 pe-sm-10">
                        <h5 class="mb-1">No Reviews</h5>
                        <span>No Reviews for this book yet.</span>
                    </div>
                    <!--end::Content-->
                </div>*@

                @* if there are Comments for this book, show it*@
                
            </div>
        </div>
        <!--end::Comments Card-->
    </div>
    <!-- end::Tab Content -->
</div>

<input type="hidden" name="__RequestVerificationToken" value="@antiforgery.GetAndStoreTokens(Context).RequestToken" />

@section Plugins
{
    <script src="~/assets/plugins/fslightbox/fslightbox.bundle.js"></script> <!-- Lightbox for the Book Cover Image -->
}

@section Scripts
{
    <script src="~/js/community/community-book.js" asp-append-version="true"></script>
}